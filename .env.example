# ---- Supabase (obligatorio) ----
# Los encuentras en Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key: SOLO para el servidor (comprobantes, descarga de archivos).
# NUNCA la expongas con NEXT_PUBLIC_ ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- PayPal (opcional: requiere cuenta de EMPRESAS, personal no da API) ----
# developer.paypal.com > Apps & Credentials > Live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AXxx...
PAYPAL_SECRET=EXxx...

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bucket PRIVADO de Supabase Storage donde subes los scripts
SCRIPTS_BUCKET=scripts
# Bucket PRIVADO para los comprobantes de transferencia
RECEIPTS_BUCKET=receipts

# ---- Cobro por transferencia bancaria (OBLIGATORIO para vender) ----
# Se muestran al comprador en /[locale]/transferencia/[orderId]
BANK_NAME=
BANK_ACCOUNT_TYPE=Corriente
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Opcionales, solo informativos
BANK_WHATSAPP=
BANK_EMAIL=
