# ---- Supabase (obligatorio) ----
# Los encuentras en Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key: SOLO para el servidor (comprobantes, descarga de archivos).
# NUNCA la expongas con NEXT_PUBLIC_ ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- PayPal (opcional: requiere cuenta de EMPRESAS, personal no da API) ----
# developer.paypal.com > Apps & Credentials > Live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=AXxx...
PAYPAL_SECRET=EXxx...

# ---- Datos legales (para términos, privacidad y reembolsos) ----
# Si faltan, las páginas avisan en rojo en lugar de publicar huecos.
LEGAL_NAME=
LEGAL_RUC=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=
# Poner en 'false' SOLO cuando un contador/abogado haya revisado el texto.
LEGAL_DRAFT=true

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bucket PRIVADO de Supabase Storage donde subes los scripts
SCRIPTS_BUCKET=scripts
# Bucket PRIVADO para los comprobantes de transferencia
RECEIPTS_BUCKET=receipts

# ---- Cobro por transferencia bancaria (OBLIGATORIO para vender) ----
# Se muestran al comprador en /[locale]/transferencia/[orderId]
BANK_NAME=
BANK_ACCOUNT_TYPE=Corriente
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
# Opcionales, solo informativos
BANK_WHATSAPP=
BANK_EMAIL=

# ---- Avisos de venta por Telegram (opcional) ----
# Token: crealo con @BotFather en Telegram.
# Chat id: mandale un mensaje al bot y abre
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# y busca "chat":{"id":123456789}
# Se avisa cuando un comprador SUBE EL COMPROBANTE, no al crear el pedido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
